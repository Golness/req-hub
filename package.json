{
  "name": "@local/req-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "check:ui": "vitest run test/client/ui-contract.test.js test/client/icon-policy.test.js",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "exports": {
    ".": "./src/server/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src/shared/",
    "lib/client.js",
    "lib/client.*.js",
    "lib/client.js.map",
    "src/server/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "DSH-UI-NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.1",
    "jsdom": "26.1.0",
    "lightningcss": "^1.28.0",
    "oxc-resolver": "^11.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.23.1",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@milkdown/core": "7.5.0",
    "@milkdown/ctx": "7.5.0",
    "@milkdown/plugin-listener": "7.5.0",
    "@milkdown/preset-commonmark": "7.5.0",
    "@milkdown/preset-gfm": "7.5.0",
    "@milkdown/prose": "7.5.0",
    "@milkdown/transformer": "7.5.0",
    "@milkdown/utils": "7.5.0",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "htmlparser2": "^12.0.0",
    "mammoth": "^1.13.0",
    "mdast-util-from-markdown": "2.0.2",
    "pdfjs-dist": "^6.4.299",
    "yauzl": "^3.4.0"
  },
  "icon": "./icon.svg"
}
